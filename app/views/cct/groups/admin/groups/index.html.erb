<% add_decidim_page_title(t("cct.groups.admin.groups.index.title")) %>

<div class="card" id="cct-groups">
  <div class="item_show__header">
    <h1 class="item_show__header-title">
      <%= t("cct.groups.admin.groups.index.title") %>
      <% if allowed_to? :create, :cct_group %>
        <%= link_to t("cct.groups.admin.groups.index.new"), new_group_path, class: "button button__sm button__secondary new" %>
      <% end %>
      <% if allowed_to? :create, :cct_group_alert %>
        <%= link_to t("cct.groups.admin.groups.index.alert"), new_alert_path, class: "button button__sm button__secondary" %>
      <% end %>
      <% if allowed_to? :index, :cct_group_alert %>
        <%= link_to t("cct.groups.admin.groups.index.alerts"), alerts_path, class: "button button__sm button__transparent-secondary" %>
      <% end %>
    </h1>
  </div>

  <p class="help-text"><%= t("cct.groups.admin.groups.index.help") %></p>

  <% if @groups.empty? %>
    <p><%= t("cct.groups.admin.groups.index.empty") %></p>
  <% else %>
    <div class="table-stacked">
      <table class="table-list">
        <thead>
          <tr>
            <th><%= t("activemodel.attributes.cct_group.name") %></th>
            <th><%= t("activemodel.attributes.cct_group.slug") %></th>
            <th><%= t("cct.groups.admin.groups.index.members") %></th>
            <th><%= t("decidim.admin.actions.actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% @groups.each do |group| %>
            <tr data-group-id="<%= group.id %>">
              <td data-label="<%= t("activemodel.attributes.cct_group.name") %>">
                <%= link_to group_name(group), group_members_path(group) %>
              </td>
              <td data-label="<%= t("activemodel.attributes.cct_group.slug") %>"><code><%= group.slug %></code></td>
              <td data-label="<%= t("cct.groups.admin.groups.index.members") %>"><%= member_counts.fetch(group.id, 0) %></td>
              <td class="table-list__actions" data-label="<%= t("decidim.admin.actions.actions") %>">
                <%= icon_link_to "team-line", group_members_path(group), t("cct.groups.admin.groups.index.manage_members"), class: "action-icon" %>
                <% if allowed_to? :update, :cct_group, group: group %>
                  <%= icon_link_to "pencil-line", edit_group_path(group), t("decidim.admin.actions.edit"), class: "action-icon--edit" %>
                <% end %>
                <% if allowed_to? :create, :cct_group_alert %>
                  <%= icon_link_to "notification-3-line", new_alert_path(group_id: group.id), t("cct.groups.admin.groups.index.alert_group"), class: "action-icon" %>
                <% end %>
                <% if allowed_to? :destroy, :cct_group, group: group %>
                  <%= button_to group_path(group), method: :delete, class: "action-icon action-icon--remove",
                                title: t("decidim.admin.actions.destroy"),
                                data: { confirm: t("cct.groups.admin.groups.index.confirm_destroy", name: group_name(group)) } do %>
                    <%= icon "delete-bin-line" %>
                    <span class="sr-only"><%= t("decidim.admin.actions.destroy") %></span>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
