# Server-side app environment. Copy to .env.production ON THE HOST ONLY.
# Generate values on the host — see README "First deploy". Never commit real values.

# Caddy site address (domain → automatic Let's Encrypt)
SITE_ADDRESS=participate.opencitieslab.africa

# Rails
SECRET_KEY_BASE=
DATABASE_PASSWORD=
DECIDIM_FORCE_SSL=true
DECIDIM_AVAILABLE_LOCALES=en,af,xh
DECIDIM_DEFAULT_LOCALE=en
DECIDIM_CURRENCY_UNIT=R
# Space-separated IPs/CIDRs allowed to reach /system — enforced by Caddy
SYSTEM_ALLOW_IPS=
# Keep EMPTY: Decidim 0.32.2's own access-list rule is inverted (blocks listed IPs, allows the rest)
DECIDIM_SYSTEM_ACCESSLIST_IPS=
DECIDIM_ADMIN_PASSWORD_STRONG=true
DECIDIM_API_JWT_SECRET=
SIDEKIQ_CONCURRENCY=5
WEB_CONCURRENCY=2
RAILS_MAX_THREADS=5

# Web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Email — Amazon SES SMTP (af-south-1), least-privilege IAM user
SMTP_FROM_LABEL=OCL Participate
SMTP_FROM_EMAIL=no-reply@participate.opencitieslab.africa
SMTP_ADDRESS=email-smtp.af-south-1.amazonaws.com
SMTP_PORT=587
SMTP_DOMAIN=participate.opencitieslab.africa
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS_AUTO=true
SMTP_AUTHENTICATION=login

# Maps (optional) — leave blank to disable
MAPS_PROVIDER=
MAPS_API_KEY=
